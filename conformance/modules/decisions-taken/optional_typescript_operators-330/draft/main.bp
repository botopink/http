//// Decision 330 — `?T` is read with TypeScript's operators and has no methods; `result` goes; a type declared in a type is its associated type.

import {io.terminal} from "std";
import {io.clock} from "std";
import {cookie, date} from "http";

pub type Visit {
    // `Seen` is declared in `Visit`'s body, so it is `Visit`'s associated type.
    pub type Seen(session: string, at: ?i64)

    pub fn read(header: string, nowMillis: i64) -> ?Visit.Seen {
        val session = cookie.get(header, "SID");
        if (session == null) return null;
        val at = date.parseHttpDate(cookie.get(header, "seen") ?? "", nowMillis);
        return Visit.Seen(session: session, at: if (at.isOk())
            at.unwrapOr(nowMillis)
        else
            null);
    }
}

fn greeting(present: bool) -> ?fn(session: string) -> string {
    return if (present)
        fn(session: string) -> string {
            return "welcome back " + session;
        }
    else
        null;
}

pub fn main() -> void {
    val header = cookie.formatHeader(
        [#("SID", "a1"), #("seen", "Sun, 06 Nov 1994 08:49:37 GMT")],
    );
    // An integer literal is `i32`; the epoch as `i64` comes from a `Duration`.
    val epoch = clock.millis(0).millis;
    val seen = Visit.read(header, epoch);
    val visits: ?Visit.Seen[] = if (seen != null) [seen] else null;
    val first = visits?.[0];
    terminal.print(first?.session ?? "anonymous");
    terminal.print(first?.at ?? epoch);
    terminal.print(Visit.read("", epoch)?.session ?? "anonymous");
    terminal.print(greeting(true)?.("a1") ?? "");
    terminal.print(greeting(false)?.("a1") ?? "no greeting");
    terminal.print(first!.session);
    terminal.print((first?.at ?? epoch) > epoch || seen == null);
    terminal.print(date.parseHttpDate("yesterday", epoch).isError());
}
